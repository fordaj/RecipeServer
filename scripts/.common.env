# scripts/.common.env — base environment for RecipeServer.
#
# Sourced by scripts/env.sh before the platform-specific env
# (.<platform>.env, e.g. .macos-x86_64.env). Platform-independent
# variables live here; OS/arch specifics live there.
#
# NOTE: runner-spawner's upstream repo is RUNNER_SPAWNER_TOOL_REPO here,
# not RUNNER_SPAWNER_REPO. The runner-spawner binary itself consumes
# RUNNER_SPAWNER_REPO for the *target* repository (see .runner-spawner.json
# / config precedence), so exporting the tool slug as RUNNER_SPAWNER_REPO
# would corrupt `runner-spawner create` URLs after `source scripts/env.sh`.

VERSIONER_REPO="fordaj/Versioner"
VERSIONER_TAG_PATTERN="v[0-9]*"
VERSIONER_CONFIG_FILE=".versioner.json"
VERSIONER_BUNDLE_DIR="tools/versioner"
LOGAMUFFIN_REPO="fordaj/logamuffin"
LOGAMUFFIN_BUNDLE_DIR="tools/logamuffin"
RUNNER_SPAWNER_TOOL_REPO="fordaj/runner-spawner"
RUNNER_SPAWNER_BUNDLE_DIR="tools/runner-spawner"
