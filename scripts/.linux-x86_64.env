# Platform env for linux-x86_64.
# Sourced by scripts/env.sh after .common.env.
# VERSIONER_BIN is resolved by env.sh to the newest
# tools/versioner/v*/linux-x86_64/versioner (fallback: versioner on PATH).
# LOGAMUFFIN_BIN is resolved by env.sh to the newest
# tools/logamuffin/v*/linux-x86_64/logamuffin (fallback: logamuffin on PATH).

RECIPE_SERVER_PLATFORM="linux-x86_64"
VERSIONER_BIN_NAME="versioner"
LOGAMUFFIN_BIN_NAME="logamuffin"
