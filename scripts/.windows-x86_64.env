# Platform env for windows-x86_64.
# Sourced by scripts/env.sh after .common.env.
# VERSIONER_BIN is resolved by env.sh to the newest
# tools/versioner/v*/windows-x86_64/versioner.exe (fallback: versioner on PATH).
# LOGAMUFFIN_BIN is resolved by env.sh to the newest
# tools/logamuffin/v*/windows-x86_64/logamuffin.exe (fallback: logamuffin on PATH).

RECIPE_SERVER_PLATFORM="windows-x86_64"
VERSIONER_BIN_NAME="versioner.exe"
LOGAMUFFIN_BIN_NAME="logamuffin.exe"
