# Platform env for windows-arm64.
# Sourced by scripts/env.sh after .common.env. Paths are relative to
# the repository root; env.sh anchors them to absolute paths.

PROJECT_PLATFORM="windows-arm64"

# NOTE: there is no windows-arm64 versioner bundle upstream (windows-x86_64
# only). This path does not exist; set VERSIONER_BIN to a versioner on PATH.
VERSIONER_BIN="${VERSIONER_VERSION_DIR}/windows-x86_64/versioner.exe"
LOGAMUFFIN_BIN="${LOGAMUFFIN_VERSION_DIR}/${PROJECT_PLATFORM}/logamuffin.exe"
RUNNER_SPAWNER_BIN="${RUNNER_SPAWNER_VERSION_DIR}/${PROJECT_PLATFORM}/runner-spawner.exe"
BARNACLE_BIN="${BARNACLE_VERSION_DIR}/${PROJECT_PLATFORM}/barnacle.exe"
WHISPER_SERVER_BIN="${WHISPER_NATIVE_VERSION_DIR}/${PROJECT_PLATFORM}/whisper-server.exe"
CADDY_BIN="${CADDY_VERSION_DIR}/${PROJECT_PLATFORM}/caddy.exe"
MKCERT_BIN="${MKCERT_VERSION_DIR}/${PROJECT_PLATFORM}/mkcert.exe"
